
@model SmartInventorySystem.Model.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-controller="Products"
               asp-action="Index"
               style="color:#9aadd0;font-size:13px;">
                <i class="bi bi-box-seam me-1"></i>
                Products
            </a>

            <i class="bi bi-chevron-right"
               style="color:#61769d;font-size:10px;"></i>

            <span style="color:#a99aff;font-size:13px;">
                Add Product
            </span>
        </div>

        <h2 style="font-size:27px;font-weight:700;">
            Add New Product
        </h2>

        <p style="color:#9aadd0;font-size:14px;">
            Enter the product details below to add a new item to your inventory.
        </p>
    </div>

    <div class="row g-4">

        <!-- Product Form -->
        <div class="col-12 col-xl-8">
            <div style="background:#101d38;border:1px solid #203456;
                        border-radius:16px;overflow:hidden;">

                <div class="p-4"
                     style="border-bottom:1px solid #203456;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center"
                             style="width:46px;height:46px;border-radius:13px;
                                    background:#6247f526;color:#a99aff;
                                    font-size:21px;">
                            <i class="bi bi-box-seam"></i>
                        </div>

                        <div>
                            <h5 class="mb-1"
                                style="font-weight:700;font-size:17px;">
                                Product Information
                            </h5>

                            <p class="mb-0"
                               style="color:#9aadd0;font-size:13px;">
                                Fields marked with * are required.
                            </p>
                        </div>
                    </div>
                </div>

                <form asp-controller="Products"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="p-4">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <!-- Product Name -->
                        <div class="mb-4">
                            <label asp-for="Name"
                                   class="form-label"
                                   style="color:#dce6ff;font-size:13px;font-weight:600;">
                                Product Name <span style="color:#ff7190;">*</span>
                            </label>

                            <div class="input-group">
                                <span class="input-group-text"
                                      style="background:#0b1429;border:1px solid #304366;
                                             color:#9aadd0;">
                                    <i class="bi bi-tag"></i>
                                </span>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="e.g. Wireless Keyboard"
                                       autocomplete="off"
                                       style="background:#0b1429;border:1px solid #304366;
                                              color:#f3f6ff;box-shadow:none;" />
                            </div>

                            <span asp-validation-for="Name"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Price and Quantity -->
                        <div class="row g-3 mb-4">

                            <div class="col-12 col-md-6">
                                <label asp-for="Price"
                                       class="form-label"
                                       style="color:#dce6ff;font-size:13px;font-weight:600;">
                                    Unit Price <span style="color:#ff7190;">*</span>
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text"
                                          style="background:#0b1429;border:1px solid #304366;
                                                 color:#9aadd0;">
                                        <i class="bi bi-currency-dollar"></i>
                                    </span>

                                    <input asp-for="Price"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="0.00"
                                           style="background:#0b1429;border:1px solid #304366;
                                                  color:#f3f6ff;box-shadow:none;" />
                                </div>

                                <span asp-validation-for="Price"
                                      class="text-danger small"></span>

                                <small style="color:#8195bb;font-size:11px;">
                                    Enter the price per unit.
                                </small>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Quantity"
                                       class="form-label"
                                       style="color:#dce6ff;font-size:13px;font-weight:600;">
                                    Initial Quantity <span style="color:#ff7190;">*</span>
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text"
                                          style="background:#0b1429;border:1px solid #304366;
                                                 color:#9aadd0;">
                                        <i class="bi bi-boxes"></i>
                                    </span>

                                    <input asp-for="Quantity"
                                           type="number"
                                           min="0"
                                           step="1"
                                           class="form-control"
                                           placeholder="0"
                                           style="background:#0b1429;border:1px solid #304366;
                                                  color:#f3f6ff;box-shadow:none;" />
                                </div>

                                <span asp-validation-for="Quantity"
                                      class="text-danger small"></span>

                                <small style="color:#8195bb;font-size:11px;">
                                    Number of units currently available.
                                </small>
                            </div>

                        </div>

                        <!-- Minimum Stock -->
                        <div class="mb-4">
                            <label asp-for="MinimumStock"
                                   class="form-label"
                                   style="color:#dce6ff;font-size:13px;font-weight:600;">
                                Minimum Stock Level <span style="color:#ff7190;">*</span>
                            </label>

                            <div class="input-group">
                                <span class="input-group-text"
                                      style="background:#0b1429;border:1px solid #304366;
                                             color:#ffb454;">
                                    <i class="bi bi-exclamation-triangle"></i>
                                </span>

                                <input asp-for="MinimumStock"
                                       type="number"
                                       min="0"
                                       step="1"
                                       class="form-control"
                                       placeholder="e.g. 10"
                                       style="background:#0b1429;border:1px solid #304366;
                                              color:#f3f6ff;box-shadow:none;" />
                            </div>

                            <span asp-validation-for="MinimumStock"
                                  class="text-danger small"></span>

                            <small style="color:#8195bb;font-size:11px;">
                                A low-stock alert appears when quantity is at or below this value.
                            </small>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex flex-wrap gap-2 pt-3"
                             style="border-top:1px solid #203456;">

                            <button type="submit"
                                    class="btn"
                                    style="background:linear-gradient(135deg,#7048ff,#4c6fff);
                                           color:white;border:none;border-radius:9px;
                                           padding:11px 20px;">
                                <i class="bi bi-check2-circle me-2"></i>
                                Save Product
                            </button>

                            <a asp-controller="Products"
                               asp-action="Index"
                               class="btn"
                               style="background:#172747;color:#dce6ff;
                                      border:1px solid #304366;border-radius:9px;
                                      padding:11px 20px;">
                                <i class="bi bi-x-circle me-2"></i>
                                Cancel
                            </a>
                        </div>

                    </div>
                </form>
            </div>
        </div>

        <!-- Information Panel -->
        <div class="col-12 col-xl-4">

            <div class="p-4 mb-4"
                 style="background:linear-gradient(145deg,#172750,#121b3c);
                        border:1px solid #304475;border-radius:16px;">

                <div class="d-flex align-items-center justify-content-center mb-3"
                     style="width:52px;height:52px;border-radius:15px;
                            background:#6247f533;color:#b4a5ff;font-size:24px;">
                    <i class="bi bi-lightbulb"></i>
                </div>

                <h5 style="font-size:16px;font-weight:700;">
                    Inventory Tips
                </h5>

                <p style="color:#aabce0;font-size:13px;line-height:1.8;">
                    Keep your inventory organized by entering accurate product
                    information and setting an appropriate minimum stock level.
                </p>

                <div class="d-flex gap-3 mt-4">
                    <i class="bi bi-check-circle-fill"
                       style="color:#00c99a;font-size:18px;"></i>

                    <div>
                        <div style="font-size:13px;font-weight:600;">
                            Accurate Pricing
                        </div>
                        <small style="color:#9aadd0;">
                            Enter the price per individual unit.
                        </small>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-3">
                    <i class="bi bi-check-circle-fill"
                       style="color:#00c99a;font-size:18px;"></i>

                    <div>
                        <div style="font-size:13px;font-weight:600;">
                            Monitor Stock
                        </div>
                        <small style="color:#9aadd0;">
                            Set a minimum quantity to help identify low stock.
                        </small>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-3">
                    <i class="bi bi-check-circle-fill"
                       style="color:#00c99a;font-size:18px;"></i>

                    <div>
                        <div style="font-size:13px;font-weight:600;">
                            Review Before Saving
                        </div>
                        <small style="color:#9aadd0;">
                            Check the product details before submitting.
                        </small>
                    </div>
                </div>
            </div>

            <div class="p-4"
                 style="background:#101d38;border:1px solid #203456;
                        border-radius:16px;">

                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-shield-check"
                       style="color:#00c99a;font-size:21px;"></i>

                    <h6 class="mb-0" style="font-weight:700;">
                        Data Validation
                    </h6>
                </div>

                <p class="mb-0"
                   style="color:#9aadd0;font-size:13px;line-height:1.8;">
                    The form validates product fields before saving.
                    Product name, price, quantity, and minimum stock must
                    satisfy the model's validation rules.
                </p>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}