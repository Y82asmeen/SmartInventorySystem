
@model IEnumerable<SmartInventorySystem.Model.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span style="color:#8b7aff; font-size:13px;">
                    <i class="bi bi-grid-1x2-fill"></i>
                    INVENTORY MANAGEMENT
                </span>
            </div>

            <h2 class="mb-2" style="font-size:27px; font-weight:700;">
                Products Management
            </h2>

            <p class="mb-0" style="color:#9aadd0; font-size:14px;">
                Manage your products, monitor stock levels and update inventory.
            </p>
        </div>

        <a asp-controller="Products"
           asp-action="Create"
           class="btn"
           style="background:linear-gradient(135deg,#7048ff,#4c6fff);
                  color:white; border:none; padding:12px 19px;
                  border-radius:10px; box-shadow:0 5px 18px #6247f530;">
            <i class="bi bi-plus-lg me-2"></i>
            Add New Product
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="h-100 p-4"
                 style="background:#101d38; border:1px solid #203456;
                        border-radius:15px;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-2" style="color:#9aadd0; font-size:13px;">
                            Total Products
                        </p>
                        <h3 class="mb-0" style="font-weight:700;">
                            @(Model?.Count() ?? 0)
                        </h3>
                    </div>

                    <div class="d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;border-radius:13px;
                                background:#6247f526;color:#9b87ff;font-size:21px;">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="h-100 p-4"
                 style="background:#101d38; border:1px solid #203456;
                        border-radius:15px;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-2" style="color:#9aadd0; font-size:13px;">
                            Available Products
                        </p>
                        <h3 class="mb-0" style="font-weight:700;">
                            @(Model?.Count(p => p.Quantity > p.MinimumStock) ?? 0)
                        </h3>
                    </div>

                    <div class="d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;border-radius:13px;
                                background:#00c99a20;color:#00c99a;font-size:21px;">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="h-100 p-4"
                 style="background:#101d38; border:1px solid #203456;
                        border-radius:15px;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-2" style="color:#9aadd0; font-size:13px;">
                            Low Stock Products
                        </p>
                        <h3 class="mb-0" style="font-weight:700;">
                            @(Model?.Count(p => p.Quantity <= p.MinimumStock) ?? 0)
                        </h3>
                    </div>

                    <div class="d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;border-radius:13px;
                                background:#ff416c20;color:#ff6384;font-size:21px;">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Products Table Panel -->
    <div style="background:#101d38; border:1px solid #203456;
                border-radius:15px; overflow:hidden;">

        <!-- Table Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 p-4"
             style="border-bottom:1px solid #203456;">

            <div>
                <h5 class="mb-1" style="font-size:17px;font-weight:700;">
                    <i class="bi bi-boxes me-2" style="color:#8b7aff;"></i>
                    Product Inventory
                </h5>

                <p class="mb-0" style="color:#9aadd0;font-size:13px;">
                    View and manage your inventory items
                </p>
            </div>

            <form method="get"
                  asp-controller="Products"
                  asp-action="Index"
                  class="d-flex flex-wrap gap-2"
                  style="max-width:100%;">

                <div class="input-group" style="width:290px;max-width:100%;">
                    <span class="input-group-text"
                          style="background:#0b1429;border:1px solid #304366;
                                 color:#9aadd0;">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           class="form-control"
                           placeholder="Search products..."
                           aria-label="Search products"
                           style="background:#0b1429;border:1px solid #304366;
                                  color:#f3f6ff;box-shadow:none;" />
                </div>

                <button type="submit"
                        class="btn btn-sm"
                        style="background:#6247f5;color:white;border-radius:8px;
                               padding:8px 14px;">
                    Search
                </button>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-sm"
                   style="background:#172747;color:#c6d2eb;border:1px solid #304366;
                          border-radius:8px;padding:8px 14px;">
                    Clear
                </a>
            </form>
        </div>

        <!-- Responsive Table -->
        <div class="table-responsive">
            <table class="table mb-0 align-middle"
                   style="--bs-table-bg:transparent;
                          --bs-table-color:#e5ecff;
                          --bs-table-border-color:#203252;
                          min-width:850px;">

                <thead>
                    <tr style="background:#0c1730;">
                        <th class="px-4 py-3"
                            style="color:#91a5ca;font-size:11px;
                                   text-transform:uppercase;letter-spacing:1px;">
                            ID
                        </th>

                        <th class="py-3"
                            style="color:#91a5ca;font-size:11px;
                                   text-transform:uppercase;letter-spacing:1px;">
                            Product Name
                        </th>

                        <th class="py-3"
                            style="color:#91a5ca;font-size:11px;
                                   text-transform:uppercase;letter-spacing:1px;">
                            Unit Price
                        </th>

                        <th class="py-3"
                            style="color:#91a5ca;font-size:11px;
                                   text-transform:uppercase;letter-spacing:1px;">
                            Quantity
                        </th>

                        <th class="py-3"
                            style="color:#91a5ca;font-size:11px;
                                   text-transform:uppercase;letter-spacing:1px;">
                            Minimum Stock
                        </th>

                        <th class="py-3"
                            style="color:#91a5ca;font-size:11px;
                                   text-transform:uppercase;letter-spacing:1px;">
                            Status
                        </th>

                        <th class="px-4 py-3 text-end"
                            style="color:#91a5ca;font-size:11px;
                                   text-transform:uppercase;letter-spacing:1px;">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td class="px-4 py-3"
                                    style="color:#91a5ca;font-size:13px;">
                                    #@product.Id
                                </td>

                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="d-flex align-items-center justify-content-center"
                                             style="width:39px;height:39px;flex-shrink:0;
                                                    border-radius:11px;background:#6247f520;
                                                    color:#a99aff;font-size:17px;">
                                            <i class="bi bi-box-seam"></i>
                                        </div>

                                        <div>
                                            <div style="font-weight:600;color:#f3f6ff;">
                                                @product.Name
                                            </div>
                                            <small style="color:#8195bb;">
                                                Product ID: @product.Id
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3" style="font-weight:600;">
                                    @product.Price.ToString("N2")
                                </td>

                                <td class="py-3">
                                    <span style="font-weight:600;">
                                        @product.Quantity
                                    </span>
                                    <small style="color:#8195bb;"> units</small>
                                </td>

                                <td class="py-3" style="color:#b5c4e1;">
                                    @product.MinimumStock
                                </td>

                                <td class="py-3">
                                    @if (product.Quantity <= product.MinimumStock)
                                    {
                                        <span class="badge rounded-pill"
                                              style="background:#ff416c20;color:#ff7190;
                                                     border:1px solid #ff416c40;">
                                            <i class="bi bi-exclamation-circle me-1"></i>
                                            Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill"
                                              style="background:#00c99a20;color:#3ce0b5;
                                                     border:1px solid #00c99a40;">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Available
                                        </span>
                                    }
                                </td>

                                <td class="px-4 py-3">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Products"
                                           asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm"
                                           title="Edit product"
                                           aria-label="Edit @product.Name"
                                           style="background:#2688ff20;color:#66adff;
                                                  border:1px solid #2688ff40;
                                                  border-radius:8px;">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-controller="Products"
                                              asp-action="Delete"
                                              asp-route-id="@product.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this product?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm"
                                                    title="Delete product"
                                                    aria-label="Delete @product.Name"
                                                    style="background:#ff416c20;color:#ff7190;
                                                           border:1px solid #ff416c40;
                                                           border-radius:8px;">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="mb-3"
                                     style="font-size:38px;color:#7185ac;">
                                    <i class="bi bi-inbox"></i>
                                </div>

                                <h6 style="color:#e5ecff;">
                                    No products found
                                </h6>

                                <p class="mb-3"
                                   style="color:#91a5ca;font-size:13px;">
                                    Try another search or add a new product to your inventory.
                                </p>

                                <a asp-controller="Products"
                                   asp-action="Create"
                                   class="btn btn-sm"
                                   style="background:#6247f5;color:white;">
                                    <i class="bi bi-plus-lg me-1"></i>
                                    Add First Product
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Table Footer -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-4 py-3"
             style="border-top:1px solid #203456;background:#0c1730;">
            <small style="color:#91a5ca;">
                Showing @(Model?.Count() ?? 0) product(s)
            </small>

            <small style="color:#7185ac;">
                <i class="bi bi-shield-check me-1"></i>
                Inventory data
            </small>
        </div>

    </div>

</div>
