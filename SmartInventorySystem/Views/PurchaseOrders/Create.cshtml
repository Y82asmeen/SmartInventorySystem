
@model SmartInventorySystem.Model.PurchaseOrder

@{
    ViewData["Title"] = "New Purchase Order";
}

<style>
    .order-form-page {
        max-width: 900px;
        margin: 0 auto;
        color: #e5e7eb;
    }

    .form-heading {
        margin-bottom: 25px;
    }

    .form-heading h2 {
        font-weight: 750;
        margin-bottom: 8px;
    }

    .form-heading p {
        color: #9ca3af;
    }

    .form-card {
        background: #151b2d;
        border: 1px solid #293249;
        border-radius: 18px;
        padding: 30px;
    }

    .section-title {
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 20px;
        padding-bottom: 13px;
        border-bottom: 1px solid #293249;
    }

    .form-label {
        color: #cbd5e1;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        background-color: #0f1525;
        border: 1px solid #35405a;
        color: #f3f4f6;
        border-radius: 10px;
        padding: 12px 14px;
    }

    .form-control:focus,
    .form-select:focus {
        background-color: #0f1525;
        color: white;
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, .15);
    }

    .form-select option {
        background: #151b2d;
        color: white;
    }

    .form-control::placeholder {
        color: #78839b;
    }

    .field-group {
        margin-bottom: 22px;
    }

    .info-note {
        background: rgba(59, 130, 246, .1);
        border: 1px solid rgba(59, 130, 246, .25);
        color: #93c5fd;
        padding: 14px 16px;
        border-radius: 10px;
        font-size: 13px;
        line-height: 1.7;
        margin-bottom: 25px;
    }

    .btn-save {
        background: #7c3aed;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 22px;
        font-weight: 600;
    }

    .btn-save:hover {
        background: #6d28d9;
        color: white;
    }

    .btn-cancel {
        background: #293249;
        color: #e5e7eb;
        border-radius: 10px;
        padding: 12px 22px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-cancel:hover {
        background: #35405a;
        color: white;
    }

    .text-danger {
        font-size: 13px;
    }

    @@media (max-width: 576px) {
        .form-card {
            padding: 20px;
        }
    }
</style>

<div class="order-form-page">
    <div class="form-heading">
        <h2>New Purchase Order</h2>
        <p>Create a purchase order and assign it to a supplier.</p>
    </div>

    <div class="form-card">
        <form asp-controller="PurchaseOrders"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <h5 class="section-title">
                <i class="bi bi-receipt me-2" style="color:#a78bfa"></i>
                Order Information
            </h5>

            <div class="row">
                <div class="col-md-6 field-group">
                    <label asp-for="SupplierId" class="form-label">
                        Supplier <span class="text-danger">*</span>
                    </label>

                    <select asp-for="SupplierId"
                            asp-items="ViewBag.SupplierId"
                            class="form-select">
                        <option value="">-- Select Supplier --</option>
                    </select>

                    <span asp-validation-for="SupplierId"
                          class="text-danger"></span>

                    <small style="color:#9ca3af">
                        Select a supplier registered in the system.
                    </small>
                </div>

                <div class="col-md-6 field-group">
                    <label asp-for="OrderDate" class="form-label">
                        Order Date <span class="text-danger">*</span>
                    </label>

                    <input asp-for="OrderDate"
                           type="date"
                           class="form-control"
                           asp-format="{0:yyyy-MM-dd}" />

                    <span asp-validation-for="OrderDate"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="field-group">
                <label asp-for="Notes" class="form-label">
                    Order Notes
                </label>

                <textarea asp-for="Notes"
                          class="form-control"
                          rows="4"
                          placeholder="Enter details or special instructions for this order..."></textarea>

                <span asp-validation-for="Notes"
                      class="text-danger"></span>
            </div>

            <div class="info-note">
                <i class="bi bi-info-circle me-2"></i>
                The order will initially have a <strong>Pending</strong> status.
                Product selection and total amount calculation will be added
                in the next step.
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn-save">
                    <i class="bi bi-check-circle me-1"></i>
                    Create Purchase Order
                </button>

                <a asp-controller="PurchaseOrders"
                   asp-action="Index"
                   class="btn-cancel">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>