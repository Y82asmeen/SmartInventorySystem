@model SmartInventorySystem.Model.PurchaseOrder

@{
    ViewData["Title"] = "Purchase Order Details";
}

<style>
    .details-page {
        color: #e5e7eb;
    }

    .details-card {
        background: #151b2d;
        border: 1px solid #293249;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 22px;
    }

    .muted {
        color: #9ca3af;
    }

    .detail-label {
        color: #9ca3af;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .detail-value {
        color: #f3f4f6;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .detail-table {
        width: 100%;
        color: #e5e7eb;
        vertical-align: middle;
    }

        .detail-table th {
            background: #111827;
            color: #9ca3af;
            font-size: 12px;
            text-transform: uppercase;
            padding: 15px;
            border-bottom: 1px solid #293249;
        }

        .detail-table td {
            background: #151b2d;
            padding: 15px;
            border-bottom: 1px solid #293249;
        }

    .status-pending {
        color: #fbbf24;
        background: rgba(245, 158, 11, .13);
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .total-box {
        background: #0f1525;
        border: 1px solid #35405a;
        padding: 20px;
        border-radius: 12px;
        text-align: right;
    }

    .total-value {
        color: #a78bfa;
        font-size: 26px;
        font-weight: 750;
    }

    @@media (max-width: 600px) {
        .details-card {
            padding: 17px;
        }

        .detail-table {
            min-width: 750px;
        }
    }
</style>

<div class="details-page">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-2">Purchase Order Details</h2>
            <p class="muted mb-0">
                Review the supplier and products in this order.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Orders
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="details-card">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="detail-label">Order Number</div>
                <div class="detail-value">PO-@Model.Id.ToString("D4")</div>
            </div>

            <div class="col-md-4">
                <div class="detail-label">Supplier</div>
                <div class="detail-value">
                    @(Model.Supplier?.Name ?? "Unknown Supplier")
                </div>
            </div>

            <div class="col-md-4">
                <div class="detail-label">Order Date</div>
                <div class="detail-value">
                    @Model.OrderDate.ToString("dd MMM yyyy")
                </div>
            </div>

            <div class="col-md-4">
                <div class="detail-label">Status</div>
                <div>
                    @if (Model.Status == "Pending")
                    {
                        <span class="status-pending">Pending</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Model.Status</span>
                    }
                </div>
            </div>

            <div class="col-12">
                <div class="detail-label">Notes</div>
                <div class="detail-value">
                    @(string.IsNullOrWhiteSpace(Model.Notes)
                        ? "No notes provided."
                        : Model.Notes)
                </div>
            </div>
        </div>
    </div>

    @if (Model.Status == "Pending" &&
         Model.Items != null &&
         Model.Items.Any())
    {
        <div class="details-card d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h5 class="fw-bold mb-1">Ready to receive this order?</h5>
                <p class="muted mb-0">
                    Receiving this order will update the inventory quantities.
                </p>
            </div>

            <form asp-controller="PurchaseOrders"
                  asp-action="Receive"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to receive this order?');">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-box-seam me-1"></i>
                    Receive Order
                </button>
            </form>
        </div>
    }

    <div class="details-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <h5 class="fw-bold mb-0">Order Items</h5>

            @if (Model.Status == "Pending")
            {
                <a asp-controller="PurchaseOrders"
                   asp-action="AddItem"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Product
                </a>
            }
        </div>

        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-box-seam fs-1 muted"></i>
                <h6 class="mt-3">No products added yet</h6>
                <p class="muted mb-0">
                    Add products to this purchase order.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table detail-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Subtotal</th>

                            @if (Model.Status == "Pending")
                            {
                                <th>Action</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@(item.Product?.Name ?? "Unknown Product")</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N2")</td>
                                <td class="fw-semibold">
                                    @item.Subtotal.ToString("N2")
                                </td>

                                @if (Model.Status == "Pending")
                                {
                                    <td>
                                        <form asp-controller="PurchaseOrders"
                                              asp-action="RemoveItem"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to remove this product?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                                Remove
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="total-box mt-3">
            <div class="detail-label">Order Total</div>
            <div class="total-value">
                @Model.TotalAmount.ToString("N2")
            </div>
        </div>
    </div>
</div>
