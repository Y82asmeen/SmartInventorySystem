
@model SmartInventorySystem.Model.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<style>
    .delete-page {
        max-width: 750px;
        margin: 30px auto;
        color: #e5e7eb;
    }

    .delete-card {
        background: #151b2d;
        border: 1px solid #293249;
        border-radius: 18px;
        padding: 30px;
    }

    .warning-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        background: rgba(239, 68, 68, .13);
        color: #f87171;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 20px;
    }

    .delete-description {
        color: #9ca3af;
        line-height: 1.7;
    }

    .supplier-info {
        background: #0f1525;
        border: 1px solid #293249;
        border-radius: 12px;
        padding: 20px;
        margin: 24px 0;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 12px 0;
        border-bottom: 1px solid #293249;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        color: #9ca3af;
    }

    .info-value {
        color: #f3f4f6;
        overflow-wrap: anywhere;
        text-align: right;
    }

    .btn-delete {
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 11px 20px;
        font-weight: 600;
    }

    .btn-delete:hover {
        background: #b91c1c;
        color: white;
    }

    .btn-cancel {
        background: #293249;
        color: #e5e7eb;
        border-radius: 10px;
        padding: 11px 20px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-cancel:hover {
        background: #35405a;
        color: white;
    }

    @@media (max-width: 576px) {
        .delete-card {
            padding: 20px;
        }

        .info-row {
            flex-direction: column;
            gap: 5px;
        }

        .info-value {
            text-align: left;
        }
    }
</style>

<div class="delete-page">
    <div class="delete-card">
        <div class="warning-icon">
            <i class="bi bi-trash3"></i>
        </div>

        <h2 class="fw-bold mb-2">Delete Supplier</h2>

        <p class="delete-description">
            Are you sure you want to delete this supplier?
            This action cannot be undone.
        </p>

        <div class="supplier-info">
            <div class="info-row">
                <span class="info-label">Supplier Name</span>
                <span class="info-value fw-semibold">@Model.Name</span>
            </div>

            <div class="info-row">
                <span class="info-label">Phone</span>
                <span class="info-value">@(Model.Phone ?? "Not provided")</span>
            </div>

            <div class="info-row">
                <span class="info-label">Email</span>
                <span class="info-value">@(Model.Email ?? "Not provided")</span>
            </div>

            <div class="info-row">
                <span class="info-label">Address</span>
                <span class="info-value">@(Model.Address ?? "Not provided")</span>
            </div>
        </div>

        <form asp-controller="Suppliers"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn-delete">
                    <i class="bi bi-trash3 me-1"></i>
                    Yes, Delete Supplier
                </button>

                <a asp-controller="Suppliers"
                   asp-action="Index"
                   class="btn-cancel">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>